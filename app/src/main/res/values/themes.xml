<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AssetTracking" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/secondary_text</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="fontFamily">@font/cairo_medium</item>
    </style>
    <style name="title_bold" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:textSize">@dimen/title_text_size</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="title_bold_blue" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:textSize">@dimen/title_text_size</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/primary_dark</item>
    </style>
    <style name="details_text_style" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:textSize">@dimen/details_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="asset_condition_style" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:textSize">@dimen/details_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="old_asset_status_style" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:textSize">@dimen/details_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/divider</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="main_category_text_style" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:textSize">@dimen/details_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="sub_category_text_style" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:textSize">@dimen/details_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="alerter_text_appearance" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:textSize">@dimen/details_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="LanguageButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dip</item>
        <item name="android:minWidth">48dip</item>
    </style>

</resources>