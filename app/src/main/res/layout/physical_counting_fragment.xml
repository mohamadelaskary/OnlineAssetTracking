<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Ui.PhysicalCountingFragment">
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:context=".Ui.PhysicalCountingFragment">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <include
                android:id="@+id/location_info"
                layout="@layout/location_info" />


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/asset_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/ic_barcode_icon"
                android:hint="@string/asset_code"
                app:boxCornerRadiusBottomEnd="5dp"
                app:boxCornerRadiusBottomStart="5dp"
                app:boxCornerRadiusTopStart="5dp"
                app:boxCornerRadiusTopEnd="5dp"
                app:helperTextEnabled="true"
                app:errorEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:singleLine="true"
                    android:lines="1"
                    android:maxLines="1"
                    android:imeOptions="actionGo" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/data_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <include
                    android:id="@+id/asset_no"
                    layout="@layout/display_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <include
                    android:id="@+id/asset_description"
                    layout="@layout/asset_description_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <include
                    android:id="@+id/asset_status_desc"
                    layout="@layout/asset_status_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/car_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/car_info"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_car"
                        app:iconGravity="start"
                        app:layout_constraintTop_toBottomOf="@+id/asset_status" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/save"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/save"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_save"
                        app:iconGravity="start"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/car_info" />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/asset_status"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/asset_status"
                        android:visibility="visible"
                        app:cornerRadius="30dp"
                        app:icon="@drawable/ic_edit_attributes"
                        app:iconGravity="start"
                        app:layout_constraintEnd_toEndOf="@+id/save"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/asset_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="@string/asset_list"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_list"
                app:iconGravity="start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/linearLayout"
                app:layout_constraintStart_toStartOf="@+id/linearLayout"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

        </LinearLayout>



</ScrollView>
    <View
        android:id="@+id/disable_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AD000000"
        android:visibility="gone"/>
    <include layout="@layout/asset_condition_bottom_sheet"
        android:id="@+id/asset_condition_bottom_sheet"
        android:visibility="visible"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>