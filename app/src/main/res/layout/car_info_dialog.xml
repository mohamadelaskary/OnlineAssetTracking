<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/custom_alert_dialog_background">

    <ImageView
        android:id="@+id/ic_plate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_plate"
        app:layout_constraintBottom_toBottomOf="@+id/car_no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/car_no" />

    <TextView
        android:id="@+id/car_no"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:text="ط د ف 8379"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginStart="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ic_plate"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ic_car_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_car_body"
        app:layout_constraintBottom_toBottomOf="@+id/body_no"
        app:layout_constraintStart_toStartOf="@+id/ic_plate"
        app:layout_constraintTop_toTopOf="@+id/body_no" />

    <TextView
        android:id="@+id/body_no"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_marginTop="3dp"
        android:gravity="start"
        android:text="12365489"
        app:layout_constraintEnd_toStartOf="@+id/ic_motor"
        app:layout_constraintStart_toEndOf="@+id/ic_plate"
        app:layout_constraintTop_toBottomOf="@+id/car_no" />

    <ImageView
        android:id="@+id/ic_motor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_motor"
        android:layout_marginEnd="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/motor_no"
        app:layout_constraintEnd_toStartOf="@+id/motor_no"
        app:layout_constraintTop_toTopOf="@+id/motor_no" />

    <TextView
        android:id="@+id/motor_no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="12365489"
        app:layout_constraintEnd_toEndOf="@+id/car_no"
        app:layout_constraintTop_toBottomOf="@+id/car_no" />

    <ImageView
        android:id="@+id/ic_fuel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_feul"
        app:layout_constraintBottom_toBottomOf="@+id/fuel_type"
        app:layout_constraintStart_toStartOf="@+id/ic_plate"
        app:layout_constraintTop_toTopOf="@+id/fuel_type" />

    <TextView
        android:id="@+id/fuel_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        android:gravity="start"
        android:text="سولار"
        app:layout_constraintEnd_toStartOf="@+id/car_model"
        app:layout_constraintStart_toEndOf="@+id/ic_fuel"
        app:layout_constraintTop_toBottomOf="@+id/body_no" />


    <TextView
        android:id="@+id/car_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="1996"
        app:layout_constraintEnd_toEndOf="@+id/car_no"
        app:layout_constraintTop_toBottomOf="@+id/motor_no" />

    <ImageView
        android:id="@+id/ic_oracle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_oracle"
        app:layout_constraintBottom_toBottomOf="@+id/oracle_serial_no"
        app:layout_constraintStart_toStartOf="@+id/ic_plate"
        app:layout_constraintTop_toTopOf="@+id/oracle_serial_no" />

    <TextView
        android:id="@+id/oracle_serial_no"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="hg5885"
        app:layout_constraintEnd_toEndOf="@+id/car_no"
        app:layout_constraintStart_toEndOf="@+id/ic_plate"
        app:layout_constraintTop_toBottomOf="@+id/fuel_type" />

</androidx.constraintlayout.widget.ConstraintLayout>