    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/user_location_loading_progress_bar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:lottie_rawRes="@raw/loading_yellow"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:visibility="gone"
        android:translationZ="3dp"
        app:layout_constraintBottom_toBottomOf="@id/load_user_location_file"
        app:layout_constraintRight_toRightOf="@id/load_user_location_file"
        app:layout_constraintTop_toTopOf="@id/load_user_location_file"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/load_asset_file"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/load_assets_file"
        app:cornerRadius="30dp"
        android:textSize="17sp"
        android:paddingVertical="10dp"

        app:layout_constraintBottom_toTopOf="@+id/load_assets_error_message"
